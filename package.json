{
  "name": "bjd-wins",
  "version": "1.0.2",
  "description": "布吉岛战绩分类与连胜统计工具",
  "author": "QCMaxcer",
  "license": "MIT",
  "private": true,
  "main": "src/desktop/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/QCMaxcer/BJD-Streaks.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win portable",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "build": {
    "appId": "net.mcbjd.bjd-streaks",
    "productName": "BJD Streaks",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "BJD-Streaks-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  }
}
